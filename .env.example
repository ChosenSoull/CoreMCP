# MCP Configuration
# HOST= Any host (default = 127.0.0.1)
# PORT= Any port (default = 44321)
# MCP_RESOURCE_URL= For generate url address (default = http://127.0.0.1:44321)
# MCP_SECRET_KEY= Bearer key (default= none)

# Tools Configuration
# USE_AGENT_TOOLS= enable agent tools True/False (no sandbox) (default = False)
# USE_RUN_SUBAGENT_TOOL= enable subagent tool True/False (default = False)

# OPENAI Configuration (CHECK USE_RUN_SUBAGENT_TOOL=TRUE)
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
# OPENAI_BASE_URL=http://localhost:8080/v1/ (Ollama, Llama.cpp)
# OPENAI_MODEL= any model (Gemma 4, Mistral, Qwen, Phi - Ahything)
# OPENAI_TEMPERATURE=0.7
# OPENAI_MAX_TOKENS=65535
# OPENAI_TOP_P=1.0
# OPENAI_SEED=None

# EMBEDDING_MODEL= You Model (default= Qwen/Qwen3-Embedding-0.6B)
# EMBEDDING_MODEL_BASE_URL= You url embedding model (default = http:127.0.0.1:8081)
# EMBEDDING_MODEL_API_KEY=YOUR_API_KEY_HERE (default= none) 
# DQUANT_DATABASE= Path Database for embeddings (default= ./dquant-database)